{
  "name": "yamlize",
  "version": "0.11.1",
  "description": "YAML templating engine with import resolution, variable substitution, and deep merge",
  "author": "Dan Lynch <pyramation@gmail.com>",
  "homepage": "https://github.com/constructive-io/dev-utils",
  "license": "MIT",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
