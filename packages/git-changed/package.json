{
  "name": "git-changed",
  "version": "0.4.0",
  "author": "Constructive <developers@constructive.io>",
  "description": "List the files changed against a merge base, including working-tree and untracked changes",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "bin": {
    "git-changed": "cli.js"
  },
  "homepage": "https://github.com/constructive-io/dev-utils",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/dev-utils"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/dev-utils/issues"
  },
  "scripts": {
    "copy": "makage assets",
    "clean": "makage clean",
    "prepublishOnly": "npm run build",
    "build": "makage build",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "makage": "0.1.10"
  },
  "keywords": [
    "git",
    "changed",
    "merge-base",
    "diff",
    "lint-staged",
    "ci",
    "incremental"
  ]
}
