{
  "name": "pnpm-policy",
  "version": "0.4.0",
  "author": "Constructive <developers@constructive.io>",
  "description": "pnpm supply-chain policy for npm maintainers — derive minimumReleaseAge exemptions and build permissions from what you publish",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "bin": {
    "pnpm-policy": "cli.js"
  },
  "homepage": "https://github.com/constructive-io/dev-utils",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/dev-utils"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/dev-utils/issues"
  },
  "scripts": {
    "copy": "makage assets",
    "clean": "makage clean",
    "prepublishOnly": "npm run build",
    "build": "makage build",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "yaml": "^2.8.4",
    "yamlize": "workspace:*"
  },
  "devDependencies": {
    "makage": "0.1.10"
  },
  "keywords": [
    "pnpm",
    "security",
    "supply-chain",
    "minimumReleaseAge",
    "allowBuilds",
    "npm",
    "maintainer",
    "workspace",
    "monorepo",
    "policy"
  ]
}
