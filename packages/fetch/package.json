{
  "name": "@constructive-io/fetch",
  "version": "1.1.0",
  "author": "Constructive <developers@constructive.io>",
  "description": "Isomorphic fetch wrapper — resolves *.localhost subdomains and preserves Host headers across Node.js and browsers",
  "main": "index.js",
  "module": "esm/index.js",
  "browser": "index.browser.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": {
        "import": "./esm/index.browser.js",
        "require": "./index.browser.js"
      },
      "workerd": {
        "import": "./esm/index.browser.js",
        "require": "./index.browser.js"
      },
      "node": {
        "import": "./esm/index.js",
        "require": "./index.js"
      },
      "default": {
        "import": "./esm/index.browser.js",
        "require": "./index.browser.js"
      }
    }
  },
  "homepage": "https://github.com/constructive-io/dev-utils",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/dev-utils"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/dev-utils/issues"
  },
  "scripts": {
    "copy": "makage assets",
    "clean": "makage clean",
    "prepublishOnly": "npm run build",
    "build": "makage build",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "fetch",
    "isomorphic",
    "localhost",
    "node",
    "browser",
    "dns",
    "host-header"
  ],
  "devDependencies": {
    "makage": "0.1.10"
  }
}
